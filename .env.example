# ================================================================
# PIXELFORGE EP2 — Variables de Entorno
# ================================================================
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" a GitHub.
# ================================================================

# Opción A: OpenAI (para embeddings + GPT-4)
OPENAI_API_KEY=sk-...

# Opción B: Groq (alternativa gratuita para el LLM)
GROQ_API_KEY=gsk_...

# Modelo a usar (cambiar según proveedor)
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=llama-3.3-70b-versatile   ← si usas Groq

# Configuración del agente
AGENT_MAX_ITERATIONS=10
AGENT_VERBOSE=true

# Configuración de RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVER_K=3
